# Copy to .env for `npm run dev`:  cp .env.example .env
# Never commit .env. Details for every variable: README.md → Environment.

# --- Required -----------------------------------------------------------------

# PostgreSQL from `npm run db:up` (docker-compose.yml).
DATABASE_URL=postgresql://vendora:vendora@localhost:5432/vendora?schema=public

# Signs customer quote links (/q/...). Any long random string, e.g. `openssl rand -hex 32`.
APP_SIGNING_SECRET=
# Optional: the previous secret while rotating, so old links keep working.
# APP_SIGNING_SECRET_OLD=

# --- Notification emails (optional; without a sender, emails are skipped) -----
# The first one set wins: Resend → Gmail API → SMTP. EMAIL_FROM is needed with any of them.

# EMAIL_FROM="Vendora <you@gmail.com>"

# Resend (needs an own, verified domain to email anyone but the account owner).
# RESEND_API_KEY=

# Gmail API over HTTPS (free; setup steps in README.md). EMAIL_FROM must be that Gmail address.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# SMTP, e.g. Gmail with an app password (blocked on hosts that close SMTP ports, like Render free).
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465

# --- Optional -----------------------------------------------------------------

# LOG_LEVEL=info
# false = this instance runs no background jobs
# RUN_WORKERS=false

# --- Set by the Shopify CLI during `npm run dev`; set them yourself on a host --
# The app's client id and secret (Dev Dashboard), and its public https URL.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=read_products,read_customers,write_draft_orders,read_inventory,read_orders,write_app_proxy

# --- Hosted only --------------------------------------------------------------
# NODE_ENV=production
# Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=staging
# Build time only: uploads source maps to Sentry.
# SENTRY_AUTH_TOKEN=

# --- Tests: put these in .env.test for `npm test` (the DB name must end in _test) --
# DATABASE_URL=postgresql://vendora:vendora@localhost:5432/vendora_test?schema=public
# SHOPIFY_API_KEY=placeholder
# SHOPIFY_API_SECRET=placeholder
# SHOPIFY_APP_URL=https://vendora.test
# SCOPES=read_products,read_customers,write_draft_orders
