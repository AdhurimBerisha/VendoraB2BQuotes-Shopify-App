// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Quote {
  id                   String         @id @default(cuid())
  shop                 String
  number               Int // shown as quotePrefix + number, e.g. Q-1001
  status               String         @default("DRAFT") // QuoteStatus in app/models/quote.server.ts
  companyId            String
  companyLocationId    String
  companyContactId     String
  contactCustomerId    String? // the contact's customer gid → customers/redact can match without Shopify
  currencyCode         String // the location's currency (D-14)
  currentVersionId     String?        @unique
  currentVersion       QuoteVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions             QuoteVersion[] @relation("QuoteVersions")
  assignedToUserId     BigInt?
  expiresAt            DateTime?
  draftOrderId         String?
  syncStatus           String         @default("NONE") // NONE | QUEUED | SYNCING | SYNCED | FAILED | NEEDS_ATTENTION
  syncError            String?
  syncClaimedAt        DateTime?
  syncedVersionId      String?
  invoiceSentVersionId String?
  invoiceRequestedAt   DateTime? // when we last asked Shopify to send the invoice (dedupe + verify)
  invoiceUrl           String? // Shopify checkout link of the sent draft order (public quote page, M3.2)
  shopifyUpdatedAt     DateTime?
  orderId              String?
  attention            Json?
  lockVersion          Int            @default(0) // optimistic lock for edits
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([shop, number])
  @@index([shop, status, updatedAt])
  @@index([shop, companyId])
  @@index([shop, expiresAt])
  @@index([shop, draftOrderId])
}

model QuoteVersion {
  id               String      @id @default(cuid())
  quoteId          String
  quote            Quote       @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Cascade)
  currentOf        Quote?      @relation("CurrentVersion")
  versionNumber    Int
  quoteDiscountPct Decimal?    @db.Decimal(7, 4)
  listTotal        Decimal     @default(0) @db.Decimal(14, 4)
  subtotal         Decimal     @default(0) @db.Decimal(14, 4)
  discountTotal    Decimal     @default(0) @db.Decimal(14, 4)
  total            Decimal     @default(0) @db.Decimal(14, 4)
  note             String?
  internalNote     String?
  createdByUserId  BigInt?
  lockedAt         DateTime? // set when submitted/sent; locked versions are never edited
  createdAt        DateTime    @default(now())
  lines            QuoteLine[]
  approvals        Approval[]

  @@unique([quoteId, versionNumber])
}

model QuoteLine {
  id            String       @id @default(cuid())
  versionId     String
  version       QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position      Int
  variantId     String
  productId     String
  sku           String?
  titleSnapshot String
  quantity      Int
  catalogPrice  Decimal      @db.Decimal(14, 4)
  overridePrice Decimal?     @db.Decimal(14, 4)
  discountPct   Decimal?     @db.Decimal(7, 4)
  lineTotal     Decimal      @db.Decimal(14, 4)
  problems      Json?

  @@index([variantId])
}

// One approval request per submitted version that hit a rule. Decided once, never edited.
model Approval {
  id          String       @id @default(cuid())
  versionId   String
  version     QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reasons     Json // [{ code, detail }], ApprovalReason in app/models/approval.ts
  requestedBy BigInt? // Shopify user id
  decidedBy   BigInt?
  decision    String? // APPROVED | REJECTED, null while pending
  comment     String?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  @@index([versionId])
}

// Append-only history of every change to a quote.
model AuditEvent {
  id        String   @id @default(cuid())
  shop      String
  quoteId   String?
  actorType String // STAFF | CUSTOMER | SYSTEM | WEBHOOK
  actorId   String?
  action    String // e.g. quote.created (list in roadmap/dev/M2.1)
  data      Json?
  createdAt DateTime @default(now())

  @@index([shop, quoteId, createdAt])
}

model Shop {
  id                String    @id // "abc.myshopify.com"
  shopGid           String? // gid://shopify/Shop/123
  installedAt       DateTime  @default(now())
  uninstalledAt     DateTime?
  timezone          String    @default("UTC") // shop.ianaTimezone
  currencyCode      String    @default("USD")
  nextQuoteNumber   Int       @default(1001)
  quotePrefix       String    @default("Q-")
  defaultExpiryDays Int       @default(30)
  approvalRules     Json      @default("{\"maxDiscountPct\":15,\"maxTotalByCurrency\":{},\"alwaysRequire\":false,\"requireDifferentApprover\":true}")
  reserveInventory  Boolean   @default(false)
  notifyEmails      String[]  @default([])
  logoUrl           String?
  quoteTerms        String?
  quoteFooter       String? // PDF footer line (M3.1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// One row per Shopify staff member who has opened the app (from their online session).
model StaffMember {
  id            String   @id @default(cuid())
  shop          String
  shopifyUserId BigInt
  displayName   String
  email         String? // only when Shopify says it's verified
  role          String   @default("REP") // Role in app/models/actor.ts; set on first visit, then only via Settings → Team (M2.4)
  locale        String   @default("en")
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([shop, shopifyUserId])
}

model WebhookEvent {
  id          String    @id // X-Shopify-Webhook-Id (unique per delivery)
  eventId     String? // X-Shopify-Event-Id (same merchant action)
  shop        String
  topic       String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([shop, receivedAt])
}

// One CSV upload into a quote's draft version: validated, previewed, then committed (M2.7).
model Import {
  id        String   @id @default(cuid())
  shop      String
  quoteId   String
  status    String // VALIDATING | READY | COMMITTED | FAILED
  fileName  String
  rowCount  Int      @default(0)
  lines     Json? // proposed lines: [{ variantId, quantity, overridePrice, discountPct }], cleared on commit
  report    Json? // ImportReport in app/models/import.server.ts
  error     String?
  createdBy BigInt?
  createdAt DateTime @default(now())

  @@index([shop, quoteId, createdAt])
}

model PrivacyRequest {
  id          String   @id @default(cuid())
  shop        String
  topic       String
  customerGid String?
  status      String   @default("READY") // READY | DELIVERED
  result      Json?
  createdAt   DateTime @default(now())

  @@index([shop])
}
